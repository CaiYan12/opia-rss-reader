# Dependencies
node_modules/

# Build outputs
out/
build/
dist/
release/

# Logs
*.log

# Secrets / env
.env
.env.*

# OS / editor
.DS_Store
Thumbs.db

# WorkBuddy agent workspace data
.workbuddy/

# Trae agent workspace data (plans etc.)
.trae/

# Local-only reference screenshots (UI design samples, not source)
testfiles/

# Local-only UI verification screenshots (agent-generated, not source)
screenshots/

# Temp scripts (agent-generated, not source)
/_*.py
/_*.js

# Local-only test fixtures (desensitized RSS snapshots, never committed)
tests/fixtures/

# Playwright run artifacts
test-results/
playwright-report/
.superpowers/

# Agent tool working data (local-only, never committed)
# .run-profile/ is an Electron profile dir and holds opia-data.json — real
# subscription/reading state. It must never reach the repository.
.run-profile/
.mimosa/
.playwright-mcp/
.zcodeignore
# CodeGraph index. The dir carries its own .gitignore that ignores everything
# except itself; the entry here keeps the stray file out of git status too.
.codegraph/

# DSH 文件工具的更新锁（写盘时生成的 0 字节锁文件，非项目产物）
.dsh-ops-update-*.lock
