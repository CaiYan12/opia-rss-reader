# Dependencies
node_modules/

# Build outputs
# out/ 例外（2026-10-25 政策）：两份被 docs/ 引用的正本经 git add -f 强跟踪，勿删——
#   out/feed-masthead-v2-implementation-2026-10-24/ledger.md（头版 V2 裁定台账）
#   out/wabi-art-implementation-2026-10-24/reviews/standards.md（wabi 轮评审报告）
# 其余 out/ 内容均为可再生产物或本地审计件。
out/
build/
dist/
release/

# Logs
*.log

# Secrets / env
.env
.env.*

# OS / editor
.DS_Store
Thumbs.db

# WorkBuddy agent workspace data
.workbuddy/

# Trae agent workspace data (plans etc.)
.trae/

# Local personal notes (never committed; see HANDOFF 2026-10-24)
.learnings/

# Local-only reference screenshots (UI design samples, not source)
testfiles/

# Local-only UI verification screenshots (agent-generated, not source)
screenshots/

# Temp scripts (agent-generated, not source)
/_*.py
/_*.js

# Local-only test fixtures (desensitized RSS snapshots stay untracked).
# 例外（2026-10-25 政策）：juya-content.html 入库——解析器契约测试与 e2e 在 CI 也要
# 跑真实样本结构，消除本地/CI 双配置；其余脱敏快照仍不入库。
tests/fixtures/*
!tests/fixtures/juya-content.html

# Playwright run artifacts
test-results/
playwright-report/
.superpowers/

# Agent tool working data (local-only, never committed)
# .run-profile/ is an Electron profile dir and holds opia-data.json — real
# subscription/reading state. It must never reach the repository.
.run-profile/
.mimosa/
.playwright-mcp/
.zcodeignore
# CodeGraph index. The dir carries its own .gitignore that ignores everything
# except itself; the entry here keeps the stray file out of git status too.
.codegraph/

# DSH 文件工具的更新锁（写盘时生成的 0 字节锁文件，非项目产物）
.dsh-ops-update-*.lock

# 图标生成过程的预览件（非构建输入；icon.ico / icon.png 仍入库）
resources/_icon_preview_*
