{
  "name": "opia-rss-reader",
  "version": "0.2.0",
  "private": true,
  "description": "Windows desktop AI news RSS reader",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build && electron-builder",
    "build:dir": "electron-vite build",
    "test": "vitest run",
    "test:e2e": "npm run build:dir && playwright test"
  },
  "build": {
    "appId": "com.opia.rssreader",
    "productName": "Opia RSS Reader",
    "directories": {
      "output": "build"
    },
    "files": [
      "out/**",
      "plugins/**",
      "resources/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "portable": {
      "artifactName": "OpiaRSSReader-v${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "electron-store": "^8.2.0",
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rss-parser": "^3.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.11.12",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
